# Copiá este archivo como ".env" (o cargá estas mismas claves como "secrets"
# en Supabase / GitHub) y completá los valores reales ahí.
# NUNCA subas un archivo ".env" real a git. Este archivo de ejemplo no debe
# tener claves verdaderas, solo nombres.

# ---- Supabase (Fase 1) ----
# URL y claves de tu proyecto de Supabase (Project Settings > API).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secreta. Solo la usan las Edge Functions del lado del servidor, nunca la landing page.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Telegram (Fase 1) ----
# Token que te da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=
# Tu chat id personal (te ayudo a obtenerlo cuando tengas el bot creado).
TELEGRAM_CHAT_ID=

# ---- Meta / Instagram / Facebook / WhatsApp (Fase 2) ----
# App ID de la app de Meta for Developers (developers.facebook.com).
META_FACEBOOK_APP_ID=
# App ID / secret específicos del producto "Instagram API with Instagram Login"
# (aparecen en Casos de uso > API de Instagram > Configuración de la API).
META_APP_ID=
META_APP_SECRET=
# Cadena aleatoria que vos elegís (ej: openssl rand -hex 24) y repetís al
# configurar el webhook en Meta — sirve para que Meta demuestre que el
# pedido de verificación es genuino.
META_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ---- Anthropic / Claude API (Fase 3) ----
ANTHROPIC_API_KEY=
# Tope de gasto diario en dólares para todas las llamadas de IA combinadas.
AI_DAILY_BUDGET_USD=5

# ---- General ----
# Zona horaria usada por los cron jobs (reportes diario/semanal).
TIMEZONE=America/Argentina/Mendoza

# ---- Motor de marketing (Bloque 4) ----
# Secreto interno para llamar a content-generator/content-analyzer/publish-content
# (no lo usa la landing ni ningún cliente público, solo cron/scripts internos).
INTERNAL_FUNCTIONS_SECRET=

# ---- Reel Engine V3.1 — voz (Bloque 8) ----
# Azure AI Speech (probado, descartado por sonar robótico — se dejó
# documentado por si se quiere volver a usar como opción gratis).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# ElevenLabs (voz elegida: "Melanie", plan Starter USD 6/mes — el plan
# free no permite usar voces de la biblioteca vía API).
ELEVENLABS_API_KEY=
